doc_sync/data/model_calls.jsonl

# Ticket runs (doc_sync/ticket.py) - copies of PDFs and live article content, kept local
doc_sync/runs/

# Discovery recall benchmark results (doc_sync/eval_recall.py) - local, rerunnable
doc_sync/eval/results/
doc_sync/data/kb_mirror/
doc_sync/data/kb_mirror.building/

